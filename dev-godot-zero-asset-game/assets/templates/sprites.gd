static var _cache: Dictionary = {}

static func get_texture(name: String) -> Texture2D:
	if _cache.has(name):
		return _cache[name]
	var def: Dictionary = SPRITES[name]
	var rows: Array = def["rows"]
	var colors: Dictionary = def["colors"]
	var img := Image.create(PIX, PIX, false, Image.FORMAT_RGBA8)
	for y in mini(rows.size(), PIX):
		var row: String = rows[y]
		for x in mini(row.length(), PIX):
			var ch := row[x]
			if ch == "." or not colors.has(ch):
				continue
			img.set_pixel(x, y, colors[ch])
	var tex := ImageTexture.create_from_image(img)
	_cache[name] = tex
	return tex
