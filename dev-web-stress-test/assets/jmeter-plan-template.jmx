          </eu.luminis.jmeter.wssampler.SingleWriteWebSocketSampler>
          <hashTree>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="刷新心跳时钟" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">vars.putObject("lastHb", System.currentTimeMillis())</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="cacheKey">refreshHbClock</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
        <eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler guiclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSamplerGui" testclass="eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler" testname="WS 等待推送（1s 可选读）" enabled="true">
          <boolProp name="createNewConnection">false</boolProp>
          <stringProp name="server">${HOST}</stringProp>
          <stringProp name="port">${PORT}</stringProp>
          <stringProp name="path">/wspayback</stringProp>
          <stringProp name="dataType">Text</stringProp>
          <stringProp name="readTimeout">1000</stringProp>
          <boolProp name="optional">true</boolProp>
        </eu.luminis.jmeter.wssampler.SingleReadWebSocketSampler>
        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="记录业务推送（延迟测量）" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">if (prev.isSuccessful() &amp;&amp; prev.getResponseData() != null) {
    String data = new String(prev.getResponseData(), "UTF-8")
    String type = data.length() &gt;= 5 ? data.substring(1, 5) : ""
    String hb = "[0000000000W2024030112000011111111222222223333333335555555556666666666677777777777]"
    if (data != hb &amp;&amp; !type.equals("0000") &amp;&amp; data.length() &gt; 81) {
        String payload = data.substring(81).replace("\"", "\"\"")
        String line = System.currentTimeMillis() + "," + ctx.getThreadNum() + "," + type + ",\"" + payload + "\"\n"
        java.nio.file.Files.write(java.nio.file.Paths.get(vars.get("PUSH_LOG")),
                line.getBytes("UTF-8"),
                java.nio.file.StandardOpenOption.CREATE, java.nio.file.StandardOpenOption.APPEND)
    }
}</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="cacheKey">logPush</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>

