    <hashTree>
      <!-- ============ S1 门户首页（-Jhome_threads=N -Jhome_loops=M） ============ -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="S1 门户首页" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
