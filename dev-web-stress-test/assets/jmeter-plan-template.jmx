<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="门户及标的详情页压测 V1.0（HTTP轮询+WS出价回报）" enabled="true">
      <stringProp name="TestPlan.comments">对应《门户及标的详情页压测方案》V1.0 场景 S1/S2/S3/S4/S5。
出价触发源（S6）不在本计划内：请并行执行 python -m autotest.client.bid_ladder run --interval 10（写操作，必须测试场次），或 python -m autotest.client.portal_stress push。
各线程组默认 0 线程（安全护栏），用 -Jxxx_threads=N 开启；线程数&gt;0 的线程组即参与压测。
WebSocket 采样器依赖插件：WebSocket Samplers by Peter Doornbosch（jmeter-websocket-samplers-1.3.2.jar，已放 lib/ext）。</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(host,119.3.239.91)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">${__P(port,9199)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ORDNO" elementType="Argument">
            <stringProp name="Argument.name">ORDNO</stringProp>
            <stringProp name="Argument.value">${__P(ordno,00000148)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ORDDATE" elementType="Argument">
            <stringProp name="Argument.name">ORDDATE</stringProp>
            <stringProp name="Argument.value">${__P(orddate,20261007)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="WAREID" elementType="Argument">
            <stringProp name="Argument.name">WAREID</stringProp>
            <stringProp name="Argument.value">${__P(wareid,10007)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="BUYORSAL" elementType="Argument">
            <stringProp name="Argument.name">BUYORSAL</stringProp>
            <stringProp name="Argument.value">${__P(buyorsal,S)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="COMPID" elementType="Argument">
            <stringProp name="Argument.name">COMPID</stringProp>
            <stringProp name="Argument.value">${__P(compid,E001)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="WS_AUTH_FRAME" elementType="Argument">
            <stringProp name="Argument.name">WS_AUTH_FRAME</stringProp>
            <stringProp name="Argument.value">[F409013200W20240301120000111111112222222233333333555555556666666666677777777777]{&quot;DATA&quot;:[{&quot;USERID&quot;:&quot;88888888&quot;,&quot;DATATIME&quot;:&quot;20240321&quot;,&quot;AUTHSTR&quot;:&quot;2494B501874781A111750CFBFB40ABEB353915629DBAC984012DB800FEB83D315&quot;}]}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="WS_HEARTBEAT" elementType="Argument">
            <stringProp name="Argument.name">WS_HEARTBEAT</stringProp>
            <stringProp name="Argument.value">[0000000000W2024030112000011111111222222223333333335555555556666666666677777777777]</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
