{
    "@platforms": [
        "android"
    ],
    "id": "",
    "name": "__APP_NAME__",
    "version": {
        "name": "1.0.0",
        "code": "100"
    },
    "description": "__APP_DESC__",
    "launch_path": "index.html",
    "developer": {
        "name": "",
        "email": "",
        "url": ""
    },
    "permissions": {},
    "plus": {
        "userAgent": {
            "value": false,
            "concatenate": false
        },
        "launchview": {
            "background": "__THEME_COLOR__"
        },
        "safearea": {
            "background": "__THEME_COLOR__",
            "bottom": {
                "offset": "none"
            }
        },
        "statusbar": {
            "immersed": "supported",
            "style": "dark",
            "background": "__THEME_COLOR__"
        },
        "screenOrientation": [
            "portrait-primary"
        ],
        "runmode": "normal",
        "signature": "",
        "allowsInlineMediaPlayback": true,
        "distribute": {
            "android": {
                "permissions": [
                    "<uses-permission android:name=\"android.permission.VIBRATE\"/>"
                ],
                "minSdkVersion": 23,
                "targetSdkVersion": 30
            },
            "icons": {
                "android": {
                    "hdpi": "icons/72.png",
                    "xhdpi": "icons/96.png",
                    "xxhdpi": "icons/144.png",
                    "xxxhdpi": "icons/192.png"
                }
            },
            "splashscreens": {
                "android": {}
            },
            "plugins": {}
        },
        "plugins": {}
    },
    "template": "default"
}
