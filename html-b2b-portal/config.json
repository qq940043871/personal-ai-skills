{
  "name": "html-b2b-portal",
  "version": "0.2.0",
  "description": "设计B2B门户与产业互联网平台（覆盖大宗商品/工业品/农产品等12个垂直行业），输出布局规范、行情组件、3D/视差动效层与响应式HTML原型；也承接一句话业务需求的澄清式功能开发（澄清 → 蓝图 → 原型或前后端代码）",
  "author": "hasWhere",
  "license": "MIT",
  "tags": ["B2B", "门户", "电商", "大宗商品", "设计规范", "UI/UX", "HTML模板", "动效", "数据可视化", "功能开发", "需求澄清", "布局选型"],
  "modes": [
    {
      "id": "A",
      "name": "展示型门户原型",
      "when": "门户/首页/找货/详情/询价/店铺等页面形态已明确",
      "entry": "SKILL.md §3 路径 A（Step 1-5）",
      "output": "单文件零构建 HTML 原型",
      "gate": "scripts/check_prototype.py + SKILL.md §7"
    },
    {
      "id": "B",
      "name": "澄清式功能开发",
      "when": "「我要开发/新增一个XX功能」等一句话业务需求",
      "entry": "SKILL.md §3 路径 B + references/feature-scaffold.md",
      "output": "HTML 原型 或 Vue + Java 前后端代码",
      "gate": "原型机检零 ERROR 或 build/compile 通过 + 交付说明",
      "phases": ["澄清提问（≤3 轮，选择题）", "蓝图确认（布局编号 + 字段表 + 接口清单）", "生成与验证"]
    }
  ],
  "workflow": [
    "路径A: 行业定档 -> industry-profiles.md",
    "路径A: 页面选型 -> page-layouts.md",
    "路径A: 组件装配 -> component-library.md（§A-E 基础组件 / §F 动效层）",
    "路径A: 数据填充 -> html-prototype-spec.md Mock Schema",
    "路径A: 质量门禁 -> scripts/check_prototype.py 机检 + SKILL.md §7 清单",
    "路径B: 澄清提问 -> references/feature-scaffold.md §1（业务本质 / 布局选型 / 接口集成）",
    "路径B: 蓝图确认 -> references/feature-scaffold.md §2",
    "路径B: 生成与验证 -> references/feature-scaffold.md §3"
  ],
  "layoutLibrary": {
    "_note": "路径 B 的布局编号。全量结构、典型场景与提问差异见 references/feature-scaffold.md §1.2。",
    "business": {
