  "assets": [
    {"path": "assets/portal-home.template.html", "type": "html-template", "purpose": "门户首页通用基座，改THEME与数据即换行业"},
    {"path": "assets/product-list.template.html", "type": "html-template", "purpose": "产品列表页基座，改filterGroups换行业筛选维度，过滤/排序/分页/双视图已内置"},
    {"path": "assets/product-detail.template.html", "type": "html-template", "purpose": "产品详情页基座，改PRODUCT.specOptions与specTable换行业规格，Tabs已内置"}
  ],
  "scripts": [
    {"path": "scripts/check_prototype.py", "loadAt": "Step5", "purpose": "交付前机检：悬空变量/FA图标语法/断点/Mock字段/空绑定/字号/体积", "usage": "python scripts/check_prototype.py 交付文件.html"}
  ],
