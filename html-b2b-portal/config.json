    "top-bar", "header", "search-bar", "main-nav", "category-nav",
    "banner", "quick-entries", "market-ticker", "market-card",
    "product-card", "supplier-card", "price-chart", "board-section",
    "service-section", "news-section", "rfq-form", "pagination",
    "tabs", "toast", "modal", "drawer", "skeleton", "empty-state", "footer",
    "fx-layer", "tilt-card", "particle-net", "hologram-globe",
    "scroll-progress", "stagger-reveal", "magnet-button"
  ],
  "motionLayer": {
    "_note": "渐进增强层。规范见 references/component-library.md §F 与 references/html-prototype-spec.md §5.1。",
    "principles": [
      "内容永不依赖动效才可见（隐藏态不挂默认选择器）",
      "无 JS / 触屏 / prefers-reduced-motion 任一成立即自动降级为静态",
      "只动 transform / opacity；大面积柔光禁用 filter:blur（用径向渐变）",
      "canvas 三条硬约束：DPR 封顶 2、节点数封顶、IntersectionObserver 离屏暂停"
    ],
    "capabilities": [
      "3D 全息地球（canvas 2D 手写投影 + slerp 大圆航线，不引 three.js）",
      "3D 倾斜卡（CSS 变量驱动 rotateX/rotateY，与悬浮上抬共存）",
      "滚动视差（data-parallax，位移按容器高度 18% 封顶）",
      "极光光斑 / 雷达扫描 / 区域聚光 / 流光边框 / 掠光 / 磁吸按钮",
      "粒子网络（就近连线 + 指针斥力）",
      "错峰进场 + 顶部滚动进度"
    ],
    "rollout": {
      "portal-home": "全量（含粒子网络与全息地球）",
      "product-list": "建议 F1/F2/F5/F7",
      "product-detail": "建议 F1/F2/F5/F7",
      "_why": "粒子网络与全息地球同页重复出现会互相打架，也拖垮体积预算，只建议首页用一次"
    }
  },
  "breakpoints": {
    "_note": "以 Tailwind Play CDN 默认断点为准（原型不写 tailwind.config）。权威说明见 references/html-prototype-spec.md §1.4。旧版曾误记为 576/768/992/1200，与产物实际行为不符。",
    "mobile": "0-639px（无前缀）",
    "sm": 640,
    "md": 768,
    "lg": 1024,
    "xl": 1280
  },
